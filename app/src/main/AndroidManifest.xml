<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Apogee requests nothing at install time. Launching the wallpaper picker, uninstalling
      through ACTION_DELETE and haptics via performHapticFeedback all work without a
      permission, and the next alarm comes from AlarmManager for free.

      The `badges` flavour adds a notification listener on top of this; see
      src/badges/AndroidManifest.xml.
    -->

    <!--
      The one permission, and it is optional: the calendar tile shows the next event only
      once the user grants this from settings. Everything else works without it. Calendar is
      not one of the permissions Play Protect blocks a sideload over (SMS, call log,
      notification listener, accessibility).
    -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Launchers are exempt from package-visibility filtering for LauncherApps, but the
         declaration keeps PackageManager label lookups working on API 30+. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".ApogeeApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Apogee">

        <activity
            android:name=".ui.LauncherActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize"
            android:enabled="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.Apogee.Launcher"
            android:windowSoftInputMode="adjustPan">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.MONKEY" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title"
            android:parentActivityName=".ui.LauncherActivity"
            android:theme="@style/Theme.Apogee.Settings">
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
