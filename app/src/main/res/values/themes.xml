<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Day values. The night overrides live in values-night; everything colour-bearing here is
      a resource so DayNight can swap it, rather than a hardcoded black.
    -->
    <style name="Theme.Apogee" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/page_bg</item>
        <item name="android:colorBackground">@color/page_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
    </style>

    <!-- The Start screen floats over the wallpaper, so its window stays see-through. -->
    <style name="Theme.Apogee.Launcher" parent="Theme.Apogee">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowContentTransitions">false</item>
    </style>

    <style name="Theme.Apogee.Settings" parent="Theme.Apogee">
        <item name="android:windowBackground">@color/page_bg</item>
    </style>

    <style name="ContextMenuAnimation" parent="">
        <item name="android:windowEnterAnimation">@anim/context_menu_in</item>
        <item name="android:windowExitAnimation">@anim/context_menu_out</item>
    </style>

    <style name="Metro.Title" parent="">
        <item name="android:textSize">@dimen/page_title_size</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- Drawn on an accent square, so the colour is set in code to stay readable. -->
    <style name="Metro.SectionHeader" parent="">
        <item name="android:textSize">@dimen/section_header_size</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Metro.AppLabel" parent="">
        <item name="android:textSize">@dimen/app_label_size</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>
</resources>
